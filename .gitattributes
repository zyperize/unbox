# Auto detect text files and perform LF normalization
* text=auto

# Force CRLF for Windows batch/PowerShell files
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Force LF for shell scripts
*.sh text eol=lf

# Force LF for source code files
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.exe binary
